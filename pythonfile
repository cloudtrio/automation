import pandas as pd
import os
import time
 
# Directory where Parquet files are stored
parquet_dir = '/home/ubuntu/03maxlife/'
 
# Directory to save CSV files
csv_dir = '/home/ubuntu/csv_files2'
os.makedirs(csv_dir, exist_ok=True)
 
# Loop through each file in the directory
for filename in os.listdir(parquet_dir):
    if filename.endswith('.parquet'):
        parquet_file = os.path.join(parquet_dir, filename)
        
        # Read the Parquet file
        df = pd.read_parquet(parquet_file)
        
        # Create the corresponding CSV file name
        csv_file = os.path.join(csv_dir, f"{os.path.splitext(filename)[0]}.csv")
        
        # Save the DataFrame to a CSV file
        df.to_csv(csv_file, index=False)
        
        print(f"Converted {filename} to CSV.")hi 
